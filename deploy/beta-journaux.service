# BETA — commit + push quotidien des journaux forward (SUIVI_*, PAPER_*) vers origin.
# Installe par : cp deploy/beta-journaux.{service,timer} /etc/systemd/system/
#                systemctl daemon-reload && systemctl enable --now beta-journaux.timer
[Unit]
Description=BETA - commit + push des journaux forward
After=network-online.target beta-paper.service
Wants=network-online.target

[Service]
# Sans HOME (unite systeme sans User=), git ne lit pas /root/.gitconfig ni ses identifiants :
# push refuse le 11/10 01:15 (« could not read Username »).
Environment=HOME=/root
Type=oneshot
WorkingDirectory=/root/BETA-
ExecStart=/root/BETA-/scripts/commit_journaux.sh
TimeoutStartSec=300
