# BETA - or intraday (XAU_SPOT) depuis 2003 : rattrapage Dukascopy, une requete toutes les 4 s,
# du plus recent au plus ancien. Bride (503 x 3) = arret propre, progression gardee ; le timer
# horaire reprend. Une fois tout lu, chaque passage ne fait plus rien (~8 570 jours au depart).
# Installe par : cp deploy/beta-marches-histo.{service,timer} /etc/systemd/system/
#                systemctl daemon-reload && systemctl enable --now beta-marches-histo.timer
[Unit]
Description=BETA - rattrapage de l'or intraday (Dukascopy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/BETA-
ExecStart=/root/venvs/beta/bin/python scripts/marches.py --dukascopy-histo --limite 700
TimeoutStartSec=3500
Nice=15
CPUQuota=25%
MemoryMax=1G
MemorySwapMax=256M
